# Copy to .env and fill in what you need. Every one of these is optional: the
# app runs with none of them set. See the configuration table in README.md for
# the rest of the knobs and their defaults.

# Postgres, if it isn't postgres@localhost/stocky
STOCKY_DB_DSN=

# DeepSeek key. Enables AI summaries and impact grading; without it both
# features report themselves unavailable and nothing else changes.
DSEEK=

# An email address you actually read. Enables the SEC EDGAR source, which
# refuses callers that don't identify themselves.
STOCKY_SEC_CONTACT=

# Set to 0 to stop a fresh database seeding itself from seed/catalogue.json on
# startup. Local search then stays empty until you follow something.
STOCKY_SEED_ON_START=
